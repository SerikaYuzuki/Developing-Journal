<%
function toStr(s) {
  if (s == null) return '';
  if (typeof s === 'object') return s.name || s.text || s.value || '';
  return String(s);
}
function strHash(s) {
  return toStr(s).split('').reduce(function(a,c){ return a + c.charCodeAt(0); }, 0);
}
function initials(name) {
  return toStr(name).split(/\s+/).filter(Boolean)
    .map(function(p){ return p[0] ? p[0].toUpperCase() : ''; })
    .join('').substring(0, 2);
}
function fmtDate(d) {
  if (!d) return '';
  try { return new Date(d).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}); }
  catch(e) { return toStr(d); }
}
function attr(s) {
  return toStr(s)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
function categoryHash(cat) {
  return '#category=' + encodeURIComponent(cat);
}
function catColorIdx(cat) { return strHash(cat) % 5; }
function encodeCategory(cat) {
  // Prefer Quarto's helper so filter/hash encoding stays in sync with metadataAttrs.
  if (typeof utils !== 'undefined' && utils && typeof utils.b64encode === 'function') {
    return utils.b64encode(cat);
  }
  return btoa(encodeURIComponent(toStr(cat)));
}
var AVATAR_GRADIENTS = [
  'linear-gradient(135deg,#7c5cff,#2fb583)',
  'linear-gradient(135deg,#3c8fcf,#7c5cff)',
  'linear-gradient(135deg,#d65a76,#d99838)',
  'linear-gradient(135deg,#2fb583,#3c8fcf)',
  'linear-gradient(135deg,#e07be0,#7c5cff)'
];
var skyCount = Math.min(3, items.length);
%>
<% if (items.length > 0) { %>
<div class="gl-hub">
<section class="gl-sky" aria-labelledby="gl-sky-title">
<header class="gl-sky-heading">
<span class="eyebrow">Knowledge constellation</span>
<h2 id="gl-sky-title">今夜の空</h2>
</header>
<div class="gl-sky-scroll">
<div class="gl-sky-grid">
<% for (let i = 0; i < skyCount; i++) { %>
<%
var item = items[i];
var rawA = Array.isArray(item.author) ? item.author : (item.author ? [item.author] : []);
var authors = rawA.map(toStr).filter(Boolean);
var cats = (item.categories || []).map(toStr).filter(Boolean);
var author0 = authors[0] || '';
var avatarBg = AVATAR_GRADIENTS[strHash(author0) % AVATAR_GRADIENTS.length];
var cat0 = cats[0] || '';
var rt = toStr(item['reading-time'] || item.readingTime || '');
var rtText = rt ? (/read/i.test(rt) ? rt.toUpperCase() : rt.toUpperCase() + ' READ') : '';
var eyebrowParts = [];
if (cat0) eyebrowParts.push(cat0.toUpperCase());
if (rtText) eyebrowParts.push(rtText);
var eyebrow = eyebrowParts.join(' · ');
var isPrimary = i === 0;
var skyRole = isPrimary ? 'primary' : 'satellite';
%>
<div class="gl-card-wrap gl-sky-card gl-sky-card--<%- skyRole %>">
<article class="gl-card">
<div class="gl-card-cover-wrap"><a href="<%- item.path %>" class="gl-card-link gl-card-cover" aria-label="<%- attr(item.title) %>"></a></div>
<% if (eyebrow) { %>
<div class="gl-eyebrow"><span class="gl-eyebrow-pill"><%- eyebrow %></span></div>
<% } %>
<h3 class="gl-title listing-title"><%- item.title %></h3>
<% if (item.description && !toStr(item.description).startsWith('<!--')) { %>
<p class="gl-desc listing-description"><%- item.description %></p>
<% } %>
<div class="gl-meta">
<% if (author0) { %>
<div class="gl-meta-col"><div class="gl-meta-lbl">AUTHOR</div><div class="gl-author-chip listing-author"><span class="gl-avatar" style="background:<%- avatarBg %>"><%- initials(author0) %></span><span class="gl-author-name"><%- author0 %></span></div></div>
<% } %>
<% if (item.date) { %>
<div class="gl-meta-col"><div class="gl-meta-lbl">PUBLISHED</div><div class="gl-meta-val listing-date"><%- fmtDate(item.date) %></div></div>
<% } %>
</div>
</article>
</div>
<% } %>
</div>
</div>
</section>

<section class="gl-log" aria-labelledby="gl-log-title">
<h2 id="gl-log-title">観測ログ</h2>
<div class="gl-log-toolbar-slot"></div>
<div class="list gl-log-list">
<% for (let i = 0; i < items.length; i++) { %>
<%
var item = items[i];
var rawA = Array.isArray(item.author) ? item.author : (item.author ? [item.author] : []);
var authors = rawA.map(toStr).filter(Boolean);
var cats = (item.categories || []).map(toStr).filter(Boolean);
var author0 = authors[0] || '';
var cat0 = cats[0] || '';
var rt = toStr(item['reading-time'] || item.readingTime || '');
var rtText = rt ? (/read/i.test(rt) ? rt.toUpperCase() : rt.toUpperCase() + ' READ') : '';
var categoriesText = cats.join(' ');
var inSky = i < skyCount ? '1' : '0';
var desc = (item.description && !toStr(item.description).startsWith('<!--')) ? item.description : '';
%>
<div class="gl-log-row" data-in-sky="<%- inSky %>"<% if (inSky === '1') { %> hidden<% } %> <%= metadataAttrs(item) %>>
<span class="gl-log-date listing-date"><%- fmtDate(item.date) %></span>
<a href="<%- item.path %>" class="gl-log-title listing-title"><%- item.title %></a>
<% if (cat0) { %>
<a class="gl-log-cat gl-cat-pill" data-gl-cat="<%- catColorIdx(cat0) %>" data-category="<%- encodeCategory(cat0) %>" href="<%- categoryHash(cat0) %>"><%- cat0 %></a>
<% } else { %>
<span class="gl-log-cat-empty" aria-hidden="true"></span>
<% } %>
<span class="listing-author gl-hidden-listing-value"><%- author0 %></span>
<span class="listing-description gl-hidden-listing-value"><%- desc %></span>
<span class="listing-categories gl-hidden-listing-value"><%- categoriesText %></span>
<span class="listing-reading-time gl-hidden-listing-value"><%- rtText %></span>
</div>
<% } %>
</div>
</section>
</div>
<% } %>
